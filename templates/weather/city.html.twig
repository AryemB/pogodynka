{% extends 'base.html.twig' %}

{% block title %}Weather in {{ location.name }}, {{ location.country }}{% endblock %}

{% block body %}
    <main style="padding: 20px; font-family: Arial, sans-serif;">
        <h1>Weather in {{ location.name }}, {{ location.country }}</h1>
        <p>Współrzędne: Szerokość {{ location.latitude }}, Długość {{ location.longitude }}</p>

        <h2>Prognoza:</h2>

        <table class="table">
            <thead>
            <tr>
                <th>Date</th>
                <th>Temperatura</th>
                <th>Wind</th>
                <th>Humidity</th>
                <th>Pressure</th>
            </tr>
            </thead>
            <tbody>
            {% for forecast in forecasts %}
                <tr>
                    <td>{{ forecast.date ? forecast.date|date('d.m.Y') : '' }}</td>
                    <td>{{ forecast.temperatura }}&deg;C</td>
                    <td>{{ forecast.wind }} km/h</td>
                    <td>{{ forecast.humidity }}%</td>
                    <td>{{ forecast.pressure }} hPa</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </main>
{% endblock %}
